# Copy to .env (not in git) and fill in. See docs/software/07-failures-deploy.md §13.

# Tokens the board and callers use to reach this service
TABLO_DEVICE_TOKEN=dev-device-token
TABLO_API_TOKEN=dev-api-token

# Companion data service (deadlines, news, grades, class feed)
TABLO_INFOMASTER_TOKEN=

# Home Assistant: long-lived access token and URL
TABLO_HA_TOKEN=
TABLO_HA_URL=http://127.0.0.1:8123

# Optional: override the listen port
# TABLO_PORT=8765
