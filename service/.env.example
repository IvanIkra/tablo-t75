# Copy to .env (not in git) and fill in. Empty values count as unset.
# See docs/software/07-failures-deploy.md §13.

# Tokens the board and API callers use to reach this service
TABLO_DEVICE_TOKEN=
TABLO_API_TOKEN=

# Companion data service (deadlines, news, grades, class feed)
TABLO_INFOMASTER_TOKEN=

# Home Assistant: URL (e.g. http://<host-ip>:8123) and a long-lived access token
TABLO_HA_URL=
TABLO_HA_TOKEN=

# Optional: listen port, 8765 by default
TABLO_PORT=

# Deployment with compose.yaml: the LAN address to publish the port on, DNS for the container
TABLO_BIND_IP=
TABLO_DNS=
TABLO_DNS_FALLBACK=

# Firmware upload through the service (firmware/tools/ota_service.py), e.g. http://<host-ip>:8765
TABLO_SERVICE=
